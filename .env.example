# TaekdHub fonctionne SANS aucune variable d'environnement : toutes les
# données vivent dans le navigateur (voir lib/store/repository.ts).
#
# La seule variable optionnelle active l'analyse par un agent depuis l'écran
# Bilan (app/api/agent/route.ts). Sans elle, l'application propose « Copier le
# contexte » : l'instantané structuré (lib/agent/snapshot.ts) se colle alors
# dans l'assistant de ton choix.
ANTHROPIC_API_KEY=

# Utilisé uniquement pour les métadonnées Open Graph et le sitemap.
NEXT_PUBLIC_SITE_URL=
