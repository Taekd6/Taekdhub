# Copier ce fichier vers .env.local. Aucune variable n'est obligatoire :
# sans elles, TaekdHub fonctionne en local seul (données dans le navigateur).

# ── Compte et synchronisation (navigateur) ───────────────────────────────
# Publiques par nature : la sécurité vient de la RLS, pas de ces valeurs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Adresse publique du site (métadonnées, robots.txt, sitemap).
# Par défaut : https://taekdhub.vercel.app
NEXT_PUBLIC_SITE_URL=

# ── Connecteur MCP pour Claude (serveur uniquement) ──────────────────────
# JAMAIS de préfixe NEXT_PUBLIC_ ici : ces valeurs ne doivent pas atteindre
# le navigateur. La clé secrète contourne la RLS.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Longue chaîne aléatoire : l'URL du connecteur est /api/mcp/<MCP_SECRET>.
# Générer : openssl rand -hex 32
MCP_SECRET=
# Facultatif : identifiant du compte (indispensable s'il y a plusieurs comptes).
MCP_USER_ID=
# Facultatif : fuseau de l'élève pour « aujourd'hui » (défaut Europe/Paris).
MCP_TIMEZONE=

# ── Notifications iPhone (Web Push) ──────────────────────────────────────
# Paire de clés VAPID — générer : npx web-push generate-vapid-keys
# La clé PUBLIQUE est lue par le navigateur (d'où NEXT_PUBLIC_), la PRIVÉE
# jamais. VAPID_SUBJECT : une adresse de contact, au format mailto:.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Protège /api/push/cron : la même valeur dans Vercel ET dans les secrets
# GitHub (Settings → Secrets and variables → Actions → CRON_SECRET).
CRON_SECRET=
