NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────
# COPILOT IA (facultatif)
#
# Sans ces variables, TaekdHub fonctionne exactement comme avant : le coach
# de raisonnement ne s'affiche simplement pas. Ce n'est pas une dégradation,
# c'est le mode par défaut.
#
# ATTENTION — la clé n'est JAMAIS préfixée par NEXT_PUBLIC_ : ce préfixe est
# précisément ce qui exposerait la valeur dans le paquet servi au navigateur.
# Elle n'est lue que par app/api/ai/route.ts, côté serveur.
# ─────────────────────────────────────────────────────────────────────
TAEKDHUB_AI_API_KEY=
# Facultatif — modèle employé. Défaut : claude-opus-5
TAEKDHUB_AI_MODEL=
